; https://github.com/sakarie9/NX-ScreenUploader
[general]
; Enable/disable upload destinations (true/false)
; Set to true to enable, false to disable
; Multiple destinations can be enabled simultaneously
telegram = false
ntfy = false
discord = false
immich = false

; Check interval in seconds (default: 5, minimum: 1)
; How often to check for new screenshots/videos.
; A shorter interval may impact system performance (CPU usage).
; A longer interval will increase the delay between capture and upload.
; check_interval = 5

; Keep log files (true/false, default: false)
; If true, log files will be kept every time the sysmodule runs
; keep_logs = false

; Log level (debug/info/warn/error, default: info)
; debug - Show all messages including debug information
; info  - Show info, warning and error messages (recommended for normal use)
; warn  - Show only warning and error messages
; error - Show only error messages
; log_level = info

; PNGShot compatibility mode (true/false, default: false)
; https://github.com/J-D-K/PNGShot
; When enabled, also monitors img:/PNGs/ for PNG screenshots produced by the PNGShot module.
; The standard album (img:/) will only collect video (.mp4) files in this mode.
; ONLY set pngshot=true if you are using PNGShot.
; pngshot = false

; Optional upload timeouts and retries are configured in the [upload] section
; at the end of this file.

; ===== Telegram Configuration =====
[telegram]
; replace with your own token, the value below is an example and will not work
bot_token = 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
; replace with your own chat id, the value below is an example and will not work
chat_id = 123456789

; Custom Telegram Bot API URL (for reverse proxy)
; Default: https://api.telegram.org
; Example: api_url = https://your-proxy-domain.com
; api_url = https://api.telegram.org

; Upload settings for Telegram
upload_screenshots = true
upload_videos = true

; Upload mode: compressed (default), original, or both
; compressed - Upload as photo/video (compressed, faster upload, saves bandwidth)
; original   - Upload as document (original quality, slower upload)
; both       - Upload compressed and original
upload_mode = compressed

; ===== ntfy.sh Configuration =====
[ntfy]
; ntfy.sh server URL (default: https://ntfy.sh)
; https://docs.ntfy.sh/publish/#limitations
; You can use a self-hosted instance here
; url = https://ntfy.sh

; Topic name (required if ntfy is enabled)
; This is where your notifications will be sent
; Choose a unique, hard-to-guess topic name
; Note: A topic without authentication is publicly accessible
; Note: if using the public ntfy.sh server, avoid common topic names to prevent others from accessing your notifications
topic = your-unique-topic-name

; Access token (optional, for protected topics)
; Leave empty if your topic doesn't require authentication
; token = tk_xxxxxxxxxxxxxxxxxxxxxxxx

; Priority (optional): max, high, default, low, min
; Default: default
; priority = default

; Upload settings for ntfy.sh
; Note: ntfy has file size limitations (2 MB on ntfy.sh), video uploads will likely fail if using the official server
upload_screenshots = true
upload_videos = false

; ===== Discord Configuration =====
[discord]
; replace with your own token, the value below is an example and will not work
bot_token = abcdefg.hjkl.whatever_aegeaseg3-feasfhr7
; replace with your own channel id, the value below is an example and will not work
channel_id = 1234567890987654321

; Discord API URL (if it ever needs to get changed)
; api_url = https://discord.com/api/v10

; Upload settings for Discord
; Videos wont work unless you are a p2w user due to size limitations
upload_screenshots = true
upload_videos = false


; ===== Immich Configuration =====
[immich]
; Replace with your instance URL. This URL should NOT include the /api since it gets handled in code
server_url = http://127.0.0.1:2283
; The Immich API key for your user account. Grab it from http://my.immich.app/user-settings?isOpen=api-keys
api_key = 123456789

; Upload settings for Immich
upload_screenshots = true
upload_videos = false


; ===== Upload tuning (optional) =====
; Every key below is optional, the defaults are shown. Details and the exact
; meaning of each value:
; https://github.com/sakarie9/NX-ScreenUploader#upload-tuning-optional
[upload]
; Timeouts in seconds, applied to every upload attempt separately.
; image_connect_timeout = 10
; image_idle_timeout = 30
; image_total_timeout = 60
; video_connect_timeout = 15
; video_idle_timeout = 60
; video_total_timeout = 300

; A transfer below this many bytes per second counts as stalled and is aborted
; after the idle timeout above.
; low_speed_limit = 1

; Total attempts per channel and file, 1 disables retries.
; image_max_attempts = 2
; video_max_attempts = 3

; Retry backoff in milliseconds: first delay, exponential growth cap, and the
; cap for a Retry-After wait requested by the server.
; retry_base_ms = 1000
; retry_max_ms = 15000
; retry_after_cap_ms = 60000

; Total time budget in seconds for a single file, counted over all channels and
; attempts. 0 disables the limit.
; image_item_budget = 0
; video_item_budget = 0
